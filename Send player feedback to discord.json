    {
      "parameters": {
        "promptType": "define",
        "text": "=Classify this player message into:\n- bug report\n- feedback\n- toxic\n\nAlso detect sentiment: positive / neutral / negative\n\nMessage: {{$json.body.message}}\n\nReturn JSON:\n{\n \"type\": \"\",\n \"sentiment\": \"\"\n}",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        -240,
        256
      ],
      "id": "05971616-550b-4437-819b-b06fc881e3ee",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "jsCode": "// Lấy raw output từ Gemini\nconst raw = $json.output;\n\n// Xóa markdown ```json ```\nconst cleaned = raw\n  .replace(/```json/g, \"\")\n  .replace(/```/g, \"\")\n  .trim();\n\n// Parse thành object\nlet parsed;\n\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = {\n    type: \"unknown\",\n    sentiment: \"unknown\"\n  };\n}\n\n// Trả về data mới\nreturn {\n  json: {\n    ...$json,\n    ai: parsed\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
